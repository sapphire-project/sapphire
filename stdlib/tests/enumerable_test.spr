class Words {
  include(Enumerable)

  attr items

  def push(w) {
    if self.items == nil { self.items = [] }
    self.items.append(w)
    self
  }

  def each {
    if self.items != nil {
      self.items.each { |w| yield(w) }
    }
  }
}

class EnumerableTest < Test {
  def test_custom_map {
    w = Words.new
    w.push("hello")
    w.push("world")
    result = w.map { |s| s.size }
    assert_equal(2, result.size)
    assert_equal(5, result[0])
    assert_equal(5, result[1])
  }

  def test_custom_select {
    w = Words.new
    w.push("hi")
    w.push("hello")
    w.push("hey")
    result = w.select { |s| s.size > 4 }
    assert_equal(1, result.size)
    assert_equal("hello", result[0])
  }

  def test_custom_reject {
    w = Words.new
    w.push("hi")
    w.push("hello")
    result = w.reject { |s| s.size > 2 }
    assert_equal(1, result.size)
    assert_equal("hi", result[0])
  }

  def test_custom_any_true {
    w = Words.new
    w.push("hello")
    assert(w.any? { |s| s.size == 5 })
  }

  def test_custom_any_false {
    w = Words.new
    w.push("hello")
    assert(!w.any? { |s| s.size == 99 })
  }

  def test_custom_all_true {
    w = Words.new
    w.push("hello")
    w.push("world")
    assert(w.all? { |s| s.size == 5 })
  }

  def test_custom_all_false {
    w = Words.new
    w.push("hi")
    w.push("hello")
    assert(!w.all? { |s| s.size == 5 })
  }

  def test_custom_none_true {
    w = Words.new
    w.push("hello")
    assert(w.none? { |s| s.size == 99 })
  }

  def test_custom_none_false {
    w = Words.new
    w.push("hello")
    assert(!w.none? { |s| s.size == 5 })
  }

  def test_custom_each_with_index {
    w = Words.new
    w.push("a")
    w.push("b")
    indices = []
    w.each_with_index { |item, i| indices.append(i) }
    assert_equal(0, indices[0])
    assert_equal(1, indices[1])
  }

  def test_custom_find {
    w = Words.new
    w.push("a")
    w.push("hello")
    assert_equal("hello", w.find { |s| s.size > 1 })
  }

  def test_custom_find_nil {
    w = Words.new
    w.push("a")
    assert_nil(w.find { |s| s.size > 5 })
  }

  def test_custom_include {
    w = Words.new
    w.push("x")
    assert(w.include?("x"))
    assert(!w.include?("z"))
  }

  def test_custom_reduce_with_initial {
    w = Words.new
    w.push("a")
    w.push("bb")
    assert_equal(3, w.reduce(0) { |acc, s| acc + s.size })
  }

}
