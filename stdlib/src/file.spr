# File provides filesystem and path helpers.
#
#   File.read("notes.txt")                 # read file contents
#   File.write("notes.txt", "hello")       # write file contents
#   File.join("tmp", "notes.txt")          # "tmp/notes.txt"
#   File.basename("/tmp/notes.txt")        # "notes.txt"
#
class File {
  self {
    # Returns true if path exists and is a directory.
    #
    #   File.directory?("tmp")   # true or false
    #
    def directory?(path) { Dir.exist?(path) }

    # Returns the final component of path, ignoring trailing slashes.
    #
    #   File.basename("/tmp/notes.txt")  # "notes.txt"
    #   File.basename("/tmp/cache/")     # "cache"
    #
    def basename(path) {
      path = self.trim_trailing_slashes(path)
      return "/" if path == "/"
      path.split("/").last
    }

    # Returns all but the final component of path.
    #
    #   File.dirname("/tmp/notes.txt")  # "/tmp"
    #   File.dirname("notes.txt")       # "."
    #
    def dirname(path) {
      path = self.trim_trailing_slashes(path)
      return "/" if path == "/"

      parts = path.split("/")
      return "." if parts.size == 1

      parts.pop
      dir = parts.join("/")
      if dir == "" { "/" } else { dir }
    }

    # Returns the extension of path's basename, including the dot.
    #
    #   File.extname("notes.txt")  # ".txt"
    #   File.extname("README")     # ""
    #
    def extname(path) {
      name = self.basename(path)
      chars = name.chars
      i = chars.size - 1

      while i > 0 {
        return name.slice(i, name.size - i) if chars[i] == "."
        i = i - 1
      }

      ""
    }

    # Removes trailing slashes while preserving the root slash.
    #
    #   File.trim_trailing_slashes("/tmp/cache/")  # "/tmp/cache"
    #
    def trim_trailing_slashes(path) {
      while path.size > 1 && path.ends_with?("/") {
        path = path.slice(0, path.size - 1)
      }
      path
    }
  }
}
