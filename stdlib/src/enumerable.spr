# Enumerable provides collection iteration helpers for any class that defines
# `each` yielding single elements.  Include this module and implement `each`
# to get map, select, reject, any?, all?, none?, each_with_index, and zip.
#
module Enumerable {
  # Returns a new list built by calling the block once per element.
  #
  #   [1, 2, 3].map { |x| x * 2 }   # [2, 4, 6]
  #
  def map {
    result = []
    each { |x| result.append(yield(x)) }
    result
  }

  # Returns a new list of elements for which the block returns truthy.
  #
  #   [1, 2, 3, 4].select { |x| x > 2 }   # [3, 4]
  #
  def select {
    result = []
    each { |x| result.append(x) if yield(x) }
    result
  }

  # Returns a new list of elements for which the block returns falsy.
  #
  #   [1, 2, 3].reject { |x| x == 2 }   # [1, 3]
  #
  def reject {
    result = []
    each { |x| result.append(x) if !yield(x) }
    result
  }

  # Returns true if the block returns truthy for at least one element.
  # Returns false for an empty collection.
  #
  #   [1, 2, 3].any? { |x| x > 2 }   # true
  #
  def any?() {
    each { |x| return true if yield(x) }
    false
  }

  # Returns true if the block returns truthy for every element.
  # Returns true for an empty collection.
  #
  #   [1, 2, 3].all? { |x| x > 0 }   # true
  #
  def all?() {
    each { |x| return false if !yield(x) }
    true
  }

  # Returns true if the block never returns truthy.
  # Returns true for an empty collection.
  #
  #   [1, 2, 3].none? { |x| x > 9 }   # true
  #
  def none?() {
    each { |x| return false if yield(x) }
    true
  }

  # Yields each element with its zero-based index.
  #
  #   ["a", "b"].each_with_index { |item, i| print "#{i}: #{item}" }
  #
  def each_with_index {
    i = 0
    each { |x|
      yield(x, i)
      i = i + 1
    }
  }

  # Returns a new list of [self_element, other_element] pairs.
  # Length follows self; other must support integer indexing.
  #
  #   [1, 2, 3].zip([4, 5, 6])   # [[1, 4], [2, 5], [3, 6]]
  #
  def zip(other) {
    result = []
    i = 0
    each { |x|
      result.append([x, other[i]])
      i = i + 1
    }
    result
  }
}
