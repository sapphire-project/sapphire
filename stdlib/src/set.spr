# Set is an unordered collection of unique values.
# Backed natively by an insertion-ordered Vec with linear deduplication.
# Construction: Set.new or Set.new([1, 2, 3])
#
class Set {
  include(Enumerable)

  # Returns a new Set containing only elements for which the block returns truthy.
  #
  #   Set.new([1, 2, 3, 4]).select { |x| x > 2 }   # Set{3, 4}
  #
  def select {
    result = Set.new
    each { |x| result.add(x) if yield(x) }
    result
  }

  # Returns a new Set containing elements for which the block returns falsy.
  #
  #   Set.new([1, 2, 3]).reject { |x| x == 2 }   # Set{1, 3}
  #
  def reject {
    result = Set.new
    each { |x| result.add(x) if !yield(x) }
    result
  }

  # Returns `[pass_set, fail_set]` like `Enumerable#partition`, but each side
  # is a `Set` instead of a list.
  #
  def partition {
    pass = Set.new
    fail = Set.new
    each { |x| if yield(x) { pass.add(x) } else { fail.add(x) } }
    [pass, fail]
  }
}
