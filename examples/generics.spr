class Box[T] {
  attr value: T

  def get -> T {
    self.value
  }

  def to_s -> String {
    "Box(#{self.value})"
  }
}

class Pair[A, B] {
  attr first: A
  attr second: B

  def swap -> Pair {
    Pair.new(first: self.second, second: self.first)
  }
}

def identity[T](x: T) -> T {
  x
}

def first_or_default[T](items: List[T], default: T) -> T {
  if items.empty? { default }
  else { items.first }
}

b = Box.new(value: 42)
puts(b.get)
puts(b.to_s)

s = Box.new(value: "hello")
puts(s.get)

p = Pair.new(first: 1, second: "one")
puts(p.first)
puts(p.second)

puts(identity(99))
puts(identity("sapphire"))

puts(first_or_default([], 0))
puts(first_or_default([10, 20, 30], 0))
