# collections.spr — lists, maps, ranges

# ── Lists ──────────────────────────────────────────────────────────────────────

numbers = [3, 1, 4, 1, 5, 9, 2, 6, 5, 3]

puts("size: #{numbers.size}")
puts("first:  #{numbers.first}")
puts("last:   #{numbers.last}")

doubled = numbers.map { |n| n * 2 }
doubled.each { |n| puts(n) }

evens = numbers.select { |n| n % 2 == 0 }
puts("even count: #{evens.size}")

total = numbers.reduce(0) { |acc, n| acc + n }
puts("sum: #{total}")

sorted = numbers.sort
puts("min: #{sorted.first}")
puts("max: #{sorted.last}")

unique = numbers.uniq
puts("unique: #{unique.size} values")

numbers.each_with_index { |n, i| puts("  [#{i}] = #{n}") }

puts("any > 8?  #{numbers.any? { |n| n > 8 }}")
puts("all > 0?  #{numbers.all? { |n| n > 0 }}")
puts("none < 0? #{numbers.none? { |n| n < 0 }}")

# List mutation
stack = []
stack.append(10)
stack.append(20)
stack.append(30)
puts("popped: #{stack.pop}")
puts("stack size: #{stack.size}")

# ── Maps ───────────────────────────────────────────────────────────────────────

scores = { alice: 95, bob: 82, carol: 91 }

puts("size: #{scores.size}")
puts("has alice? #{scores.has_key?("alice")}")
puts("has dave?  #{scores.has_key?("dave")}")

scores.each { |name, score| puts("  #{name}: #{score}") }

passing = scores.select { |name, score| score >= 90 }
puts("passing count: #{passing.size}")

extras = { dave: 78 }
all_scores = scores.merge(extras)
puts("total students: #{all_scores.size}")

# ── Ranges ─────────────────────────────────────────────────────────────────────

puts("Counting:")
(1..5).each { |i| puts(i) }

puts("includes 3? #{(1..5).include?(3)}")
puts("includes 6? #{(1..5).include?(6)}")
