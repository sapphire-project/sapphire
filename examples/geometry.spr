import "./geometry/point"
import "./geometry/shapes"

a = Point.new(x: 0.0, y: 0.0)
b = Point.new(x: 3.0, y: 4.0)

IO.puts("Points:")
IO.puts("  a = #{a.to_s}")
IO.puts("  b = #{b.to_s}")
IO.puts("  distance a->b = #{a.distance_to(b)}")
IO.puts("  b translated by (1, -1) = #{b.translate(1.0, -1.0).to_s}")

IO.puts("")
IO.puts("Circle:")
c = Circle.new(center: a, radius: 5.0)
IO.puts("  #{c.to_s}")
IO.puts("  area = #{c.area}")
IO.puts("  contains b? #{c.contains(b)}")
IO.puts("  contains (10, 10)? #{c.contains(Point.new(x: 10.0, y: 10.0))}")

IO.puts("")
IO.puts("Rectangle:")
r = Rectangle.new(top_left: Point.new(x: 1.0, y: 1.0), width: 6.0, height: 4.0)
IO.puts("  #{r.to_s}")
IO.puts("  area = #{r.area}")
IO.puts("  perimeter = #{r.perimeter}")
