# error_handling.spr — raise, begin/rescue/else/end

# Basic begin/rescue
begin
  raise "something went wrong"
rescue e
  IO.puts("Caught: #{e}")
end

# else runs only when no exception is raised
begin
  x = 10 / 2
rescue e
  IO.puts("division failed: #{e}")
else
  IO.puts("result: #{x}")
end

# Rescue a runtime error (division by zero)
begin
  result = 1 / 0
rescue e
  IO.puts("runtime error caught: #{e}")
end

# Raise inside a function with rescue at the call site
def parse_age(s: String) -> Int {
  age = s.to_i
  raise "age must be positive" if age <= 0
  age
}

begin
  IO.puts(parse_age("25"))
  IO.puts(parse_age("0"))
rescue e
  IO.puts("bad input: #{e}")
end

# Inline rescue inside a function body
def safe_divide(a: Int, b: Int) -> Int {
  a / b
rescue e
  IO.puts("cannot divide by zero, returning 0")
  0
}

IO.puts(safe_divide(10, 2))
IO.puts(safe_divide(10, 0))
