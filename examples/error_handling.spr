# error_handling.spr — raise, try/rescue/else/ensure

# Basic try/rescue
try {
  raise "something went wrong"
} rescue e {
  puts("Caught: #{e}")
}

# else runs only when no exception is raised
try {
  x = 10 / 2
} rescue e {
  puts("division failed: #{e}")
} else {
  puts("result: #{x}")
}

# Rescue a runtime error (division by zero)
try {
  result = 1 / 0
} rescue e {
  puts("runtime error caught: #{e}")
}

# Raise inside a function with rescue at the call site
def parse_age(s: String) -> Int {
  age = s.to_i
  raise "age must be positive" if age <= 0
  age
}

try {
  puts(parse_age("25"))
  puts(parse_age("0"))
} rescue e {
  puts("bad input: #{e}")
}

# Inline rescue inside a function body
def safe_divide(a: Int, b: Int) -> Int {
  a / b
rescue e
  puts("cannot divide by zero, returning 0")
  0
}

puts(safe_divide(10, 2))
puts(safe_divide(10, 0))
