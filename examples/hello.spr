# hello.spr — variables, arithmetic, string interpolation

name = "Sapphire"
version = 1

puts("Hello from #{name} v#{version}!")

x = 10
y = 3
puts("#{x} + #{y} = #{x + y}")
puts("#{x} - #{y} = #{x - y}")
puts("#{x} * #{y} = #{x * y}")
puts("#{x} / #{y} = #{x / y}")
puts("#{x} % #{y} = #{x % y}")

pi = 3.14159
puts("pi is approximately #{pi}")
puts("pi rounded down: #{pi.to_i}")
